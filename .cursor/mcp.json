{
  "mcpServers": {
    "lambda": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@strand-ai/lambda-mcp"
      ],
      "env": {
        "LAMBDA_API_KEY": "${env:LAMBDA_API_KEY}"
      }
    },
    "nango-management": {
      "url": "https://mcp.nango.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${env:NANGO_API_KEY}"
      }
    }
  }
}
